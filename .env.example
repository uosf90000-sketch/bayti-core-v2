# Never commit real secrets.
# Tectly defaults to sandbox unless TECTLY_API_BASE_URL is explicitly set.
TECTLY_CLIENT_ID=
TECTLY_CLIENT_SECRET=
TECTLY_API_BASE_URL=https://sandbox.platform.tectly.com/api/v1

REPLICATE_API_TOKEN=
REPLICATE_FLOORPLAN_MODEL=ton731/floorplan-recognition
REPLICATE_FLOORPLAN_VERSION=6d9285b49483724cfa20294f80f711ca32fc1c488bb98ca01f0499651d966773

# Protects POST /v1/analyze. Keep this server-side.
BAYTI_CORE_API_KEY=

# Paid-analysis replay guard. Default TTL is 30 minutes.
BAYTI_CORE_IDEMPOTENCY_TTL_MS=1800000
# For restart-safe deduplication, point this at a mounted persistent volume directory.
# Example on a mounted Railway volume: /data/bayti-core-idempotency
BAYTI_CORE_IDEMPOTENCY_DIR=
# Production can require durable idempotency before /ready returns 200.
BAYTI_CORE_REQUIRE_PERSISTENT_IDEMPOTENCY=false

# Optional request body limit; default is 35 MiB.
BAYTI_CORE_MAX_BODY_BYTES=36700160
